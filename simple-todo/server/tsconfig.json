{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "ES2023",                                  
    "module": "ESNext",    
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,                            
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
    "ts-node":{
    "esm:": true
  }, 
  "include": ["src/**/*"]                                 
}
