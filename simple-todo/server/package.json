{
  "name": "simple_todo_server",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "dev": "NODE_ENV=development concurrently \"npx tsc  --watch\" \"nodemon  -q dist/server.js\"",
    "dev:debug": "NODE_ENV=development node --inspect-brk --import tsx src/server.ts",
    "test": "NODE_ENV=test npx vitest",
    "test:debug": "NODE_ENV=test npx vitest --inspect-brk --no-file-parallelism --test-timeout=0",
    "db:create": "npx tsx src/api/v1/db/scripts/createDatabase.ts",
    "db:migration:clean": "rm -f src/api/v1/db/migration/* && rm -f dist/src/api/v1/db/migration/*",
    "db:migration:generate": "npx typeorm-ts-node-esm migration:generate -d src/api/v1/db/data-source.ts src/api/v1/db/migration/todolist_db_migration",
    "db:migration:generate:test": "npx typeorm-ts-node-esm migration:generate -d src/api/v1/db/data-source.ts src/api/v1/db/migration/todolist_test_db_migration",
    "db:migrate": "npx typeorm-ts-node-esm migration:run -d src/api/v1/db/data-source.ts",
    "dev:prep": "NODE_ENV=development npm run db:create && npm run db:migration:clean && NODE_ENV=development npm run db:migration:generate && NODE_ENV=development npm run db:migrate",
    "test:prep": "NODE_ENV=test npm run db:create && npm run db:migration:clean && NODE_ENV=test npm run db:migration:generate:test && NODE_ENV=test npm run db:migrate"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "debug": "~2.6.9",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "http-errors": "~1.6.3",
    "http-status": "^1.6.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^6.3.3",
    "ts-node-register": "^1.0.0",
    "typeorm": "^1.0.0",
    "vite-plugin-node": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.3",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.21.0",
    "@swc/core": "^1.16.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^2.0.12",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "bcrypt": "^5.1.0",
    "concurrently": "^7.6.0",
    "nodemon": "^3.0.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
