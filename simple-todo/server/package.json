{
  "name": "simple_todo_server",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/src/server.js",
    "dev": "NODE_ENV=development concurrently \"npx tsc  --watch\" \"nodemon  -q dist/src/server.js\"",
    "start:debug:ts": "NODE_ENV=development node --inspect-brk --import tsx src/server.ts",
    "test": "NODE_ENV=test jest --detectOpenHandles",
    "db": "NODE_ENV=development npx tsx src/api/v1/db/scripts/createDatabase.ts",
    "db:test": "NODE_ENV=test sequelize db:create && NODE_ENV=test sequelize db:migrate"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "http-errors": "~1.6.3",
    "http-status": "^1.6.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^6.3.3",
    "ts-node-register": "^1.0.0",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.3",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.21.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^2.0.12",
    "bcrypt": "^5.1.0",
    "concurrently": "^7.6.0",
    "nodemon": "^3.0.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.0",
    "tsx": "^4.23.1",
    "typescript": "^4.9.5",
    "vitest": "^4.1.0"
  }
}
